{
  "name": "yapyak",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "default": "./dist/adapter/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./config/internal": {
      "types": "./dist/config/internal/index.d.ts",
      "default": "./dist/config/internal/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./processor": {
      "types": "./dist/processor/index.d.ts",
      "default": "./dist/processor/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./translator": {
      "types": "./dist/translator/index.d.ts",
      "default": "./dist/translator/index.js"
    },
    "./translator/internal": {
      "types": "./dist/translator/internal/index.d.ts",
      "default": "./dist/translator/internal/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "yapyak": "./dist/cli/run.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm -w vitest --run --project=yapyak",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
    "jiti": "catalog:",
    "magic-string": "catalog:",
    "picomatch": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@yapyak/tsup-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "@yapyak/vitest-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
