{
  "name": "@yapyak/astro",
  "version": "0.0.0",
  "description": "Astro bindings for yapyak.",
  "keywords": [
    "astro",
    "bindings",
    "i18n",
    "translation",
    "yapyak"
  ],
  "homepage": "https://yapyak.dev",
  "bugs": "https://github.com/yapyak/yapyak/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapyak/yapyak.git",
    "directory": "packages/astro"
  },
  "license": "MIT",
  "author": "Joakim Uhrwing",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "default": "./dist/integration.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w vitest --run --project=@yapyak/astro",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "catalog:",
    "@yapyak/vite": "workspace:*"
  },
  "devDependencies": {
    "@types/estree": "catalog:",
    "@types/estree-jsx": "catalog:",
    "@types/node": "catalog:",
    "@yapyak/tsdown-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "astro": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7",
    "yapyak": "workspace:*"
  },
  "engines": {
    "node": ">=22.12"
  }
}
