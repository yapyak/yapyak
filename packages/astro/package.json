{
  "name": "@yapyak/astro",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yapyak/vite": "workspace:*",
    "yapyak": "workspace:*"
  },
  "peerDependencies": {
    "@astrojs/compiler": ">=2.0.0",
    "astro": ">=5"
  },
  "peerDependenciesMeta": {
    "@astrojs/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/compiler": "catalog:",
    "@types/node": "catalog:",
    "@yapyak/tsup-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "astro": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
