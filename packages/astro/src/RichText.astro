---
import type { RichTextHandler } from 'yapyak';

import { richText } from 'yapyak';

/**
 * Props for the `RichText` Astro component.
 *
 * @remarks
 * Each named tag found in `value` can be supplied via a prop of the same name with a {@link RichTextHandler}. A tag with no matching handler renders as its inner text.
 */
interface Props {
  value: string;
  [tagName: string]: RichTextHandler | string;
}

const { value, ...restProps } = Astro.props;
const html = richText(value, restProps);
---

<Fragment set:html={html} />
