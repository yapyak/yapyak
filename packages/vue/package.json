{
  "name": "@yapyak/vue",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yapyak": "workspace:*"
  },
  "peerDependencies": {
    "@vue/compiler-core": ">=3.0.0",
    "@vue/compiler-sfc": ">=3.0.0",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-core": {
      "optional": true
    },
    "@vue/compiler-sfc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vue/compiler-core": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@yapyak/tsup-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
