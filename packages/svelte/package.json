{
  "name": "@yapyak/svelte",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup",
    "test": "pnpm -w vitest --run --project=@yapyak/svelte",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@yapyak/tsup-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "@yapyak/vitest-config": "workspace:*",
    "happy-dom": "catalog:",
    "svelte": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": ">=5",
    "yapyak": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
