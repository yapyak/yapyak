{
  "name": "@yapyak/svelte",
  "version": "0.0.0",
  "description": "Svelte bindings for yapyak.",
  "keywords": [
    "bindings",
    "i18n",
    "svelte",
    "translation",
    "yapyak"
  ],
  "homepage": "https://yapyak.dev",
  "license": "MIT",
  "author": "Joakim Uhrwing",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "svelte": "./src/internal.ts",
      "default": "./src/internal.ts"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w vitest --run --project=@yapyak/svelte",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "@yapyak/tsdown-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "@yapyak/vitest-config": "workspace:*",
    "happy-dom": "catalog:",
    "svelte": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": ">=5",
    "yapyak": ">=0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
