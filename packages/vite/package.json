{
  "name": "@yapyak/vite",
  "version": "0.0.0",
  "description": "Vite plugin for yapyak.",
  "keywords": [
    "i18n",
    "plugin",
    "translation",
    "vite",
    "yapyak"
  ],
  "homepage": "https://yapyak.dev",
  "license": "MIT",
  "author": "Joakim Uhrwing",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w vitest --run --project=@yapyak/vite",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yapyak/tsdown-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=6",
    "yapyak": ">=0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
