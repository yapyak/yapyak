{
  "name": "@yapyak/doc-extractor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ambient": "./src/ambient.d.ts",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/ambient.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@markdoc/markdoc": "catalog:",
    "typedoc": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yapyak/tsup-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=5"
  }
}
