{
  "name": "@yapyak/sveltekit",
  "version": "0.0.14",
  "description": "SvelteKit adapter for yapyak.",
  "keywords": [
    "adapter",
    "i18n",
    "svelte",
    "sveltekit",
    "translation",
    "yapyak"
  ],
  "homepage": "https://yapyak.dev",
  "bugs": "https://github.com/yapyak/yapyak/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapyak/yapyak.git",
    "directory": "packages/sveltekit"
  },
  "license": "MIT",
  "author": "Joakim Uhrwing",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w vitest --run --project=@yapyak/sveltekit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/kit": "catalog:",
    "@yapyak/tsdown-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "svelte": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2",
    "yapyak": "workspace:*"
  },
  "engines": {
    "node": ">=22.22"
  },
  "publishConfig": {
    "access": "public"
  }
}
