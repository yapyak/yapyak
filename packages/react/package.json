{
  "name": "@yapyak/react",
  "version": "0.0.0",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w vitest --run --project=@yapyak/react",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yapyak/tsdown-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "@yapyak/vitest-config": "workspace:*",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "yapyak": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
