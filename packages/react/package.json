{
  "name": "@yapyak/react",
  "version": "0.0.15",
  "description": "React bindings for yapyak.",
  "keywords": [
    "bindings",
    "i18n",
    "react",
    "translation",
    "yapyak"
  ],
  "homepage": "https://yapyak.dev",
  "bugs": "https://github.com/yapyak/yapyak/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapyak/yapyak.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Joakim Uhrwing",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler-runtime/internal": {
      "types": "./dist/compiler-runtime/internal.d.ts",
      "react-server": "./dist/compiler-runtime/internal.server.js",
      "default": "./dist/compiler-runtime/internal.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "pnpm -w vitest --run --project=@yapyak/react",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yapyak/tsdown-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "@yapyak/vitest-config": "workspace:*",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "yapyak": "workspace:*"
  },
  "engines": {
    "node": ">=22.22"
  },
  "publishConfig": {
    "access": "public"
  }
}
