{
  "name": "yapyak-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"@yapyak/*\" build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "generate:readmes": "node --experimental-strip-types scripts/generate-readmes.ts",
    "test": "pnpm -r --filter \"@yapyak/*\" test",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@yapyak/biome-config": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
