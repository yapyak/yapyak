{
  "name": "yapyak-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "check": "biome check .",
    "check:write": "biome check . --write",
    "knip": "knip -W './packages/*' -W '!./packages/*-config'",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "knip": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
