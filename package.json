{
  "name": "yapyak",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/with-locale": {
      "types": "./dist/react/with-locale.d.ts",
      "default": "./dist/react/with-locale.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./vue/with-locale": {
      "types": "./dist/vue/with-locale.d.ts",
      "default": "./dist/vue/with-locale.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./svelte/with-locale": {
      "types": "./dist/svelte/with-locale.d.ts",
      "default": "./dist/svelte/with-locale.js"
    },
    "./vite": {
      "types": "./dist/vite/plugin.d.ts",
      "default": "./dist/vite/plugin.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./adapters/sveltekit": {
      "types": "./dist/adapters/sveltekit.d.ts",
      "default": "./dist/adapters/sveltekit.js"
    },
    "./adapters/tanstack-start": {
      "types": "./dist/adapters/tanstack-start.d.ts",
      "default": "./dist/adapters/tanstack-start.js"
    },
    "./translators": {
      "types": "./dist/translators/types.d.ts",
      "default": "./dist/translators/types.js"
    },
    "./translators/anthropic": {
      "types": "./dist/translators/anthropic.d.ts",
      "default": "./dist/translators/anthropic.js"
    },
    "./translators/openai": {
      "types": "./dist/translators/openai.d.ts",
      "default": "./dist/translators/openai.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2",
    "react": ">=19",
    "svelte": ">=5",
    "vite": ">=5",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@sveltejs/kit": "^2.59.1",
    "@tanstack/react-start": "^1.167.65",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "3.0.4",
    "vue": "3.5.13"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "yaml": "^2.8.4"
  }
