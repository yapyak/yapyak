{
  "name": "yapyak",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./internal": {
      "default": "./dist/internal/index.js"
    },
    "./vite": {
      "types": "./dist/vite/plugin.d.ts",
      "default": "./dist/vite/plugin.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "default": "./dist/adapter/index.js"
    },
    "./adapter/astro": {
      "types": "./dist/adapter/astro.d.ts",
      "default": "./dist/adapter/astro.js"
    },
    "./adapter/react-router": {
      "types": "./dist/adapter/react-router.d.ts",
      "default": "./dist/adapter/react-router.js"
    },
    "./adapter/sveltekit": {
      "types": "./dist/adapter/sveltekit.d.ts",
      "default": "./dist/adapter/sveltekit.js"
    },
    "./adapter/tanstack-start": {
      "types": "./dist/adapter/tanstack-start.d.ts",
      "default": "./dist/adapter/tanstack-start.js"
    },
    "./translator": {
      "types": "./dist/translator/index.d.ts",
      "default": "./dist/translator/index.js"
    },
    "./translator/anthropic": {
      "types": "./dist/translator/anthropic.d.ts",
      "default": "./dist/translator/anthropic.js"
    },
    "./translator/openai": {
      "types": "./dist/translator/openai.d.ts",
      "default": "./dist/translator/openai.js"
    },
    "./translator/gemini": {
      "types": "./dist/translator/gemini.d.ts",
      "default": "./dist/translator/gemini.js"
    },
    "./translator/ollama": {
      "types": "./dist/translator/ollama.d.ts",
      "default": "./dist/translator/ollama.js"
    }
  },
  "bin": {
    "yapyak": "./dist/cli/run.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2",
    "astro": ">=5",
    "react": ">=19",
    "react-router": ">=7.9",
    "svelte": ">=5",
    "vite": ">=5",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yapyak/biome-config": "workspace:*",
    "@yapyak/typescript-config": "workspace:*",
    "astro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
