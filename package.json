{
  "name": "yapyak-monorepo",
  "private": true,
  "homepage": "https://yapyak.dev",
  "bugs": "https://github.com/yapyak/yapyak/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapyak/yapyak.git"
  },
  "author": "Joakim Uhrwing",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "check": "biome check . --error-on-warnings",
    "check:write": "biome check . --write",
    "e2e:dev": "pnpm --filter @yapyak/e2e test:dev",
    "e2e:prod": "pnpm -r --filter \"./examples/*\" build && pnpm --filter @yapyak/e2e test:prod",
    "knip": "knip -W './packages/*' -W '!./packages/*-config' -W './e2e'",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "knip": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.22"
  }
}
