{
  "name": "yapyak-monorepo",
  "private": true,
  "homepage": "https://yapyak.dev",
  "bugs": "https://github.com/yapyak/yapyak/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapyak/yapyak.git"
  },
  "author": "Joakim Uhrwing",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./docs/compiler\" build",
    "check": "biome check . --error-on-warnings",
    "check:write": "biome check . --write --error-on-warnings",
    "e2e:dev": "pnpm --filter @yapyak/e2e test:dev",
    "e2e:prod": "pnpm -r --filter \"./examples/*\" build && pnpm --filter @yapyak/e2e test:prod",
    "knip": "knip -W './packages/*' -W '!./packages/*-config' -W './docs/compiler' -W './e2e'",
    "release": "pnpm build && pnpm typecheck && pnpm test && changeset publish",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.22"
  }
}
