{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "extends": ["@yapyak/biome-config"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.css",
      "**/*.json",
      "**/*.jsonc",
      "!**/dist",
      "!**/node_modules",
      "!**/routeTree.gen.*",
      "!**/manifest.json",
      "!**/parser/fixtures"
    ]
  }
}
