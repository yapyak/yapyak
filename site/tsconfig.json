{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "#components/*": ["./src/components/*"],
      "#docs/*": ["./src/docs/*"],
      "#lib/*": ["./src/lib/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"]
}
