{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#components/*": ["./src/components/*"],
      "#docs/*": ["./src/docs/*"],
      "#hooks/*": ["./src/hooks/*"],
      "#types": ["./src/types.ts"],
      "#utils/*": ["./src/utils/*"]
    },
    "types": ["node", "vite/client", "@yapyak/doc-extractor/virtual"]
  },
  "extends": "@yapyak/typescript-config/react",
  "include": ["src/**/*"]
}
