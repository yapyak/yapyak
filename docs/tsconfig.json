{
  "compilerOptions": {
    "paths": {
      "#components/*": ["./src/components/*"],
      "#docs/*": ["./src/docs/*"],
      "#hooks/*": ["./src/hooks/*"],
      "#lib/*": ["./src/lib/*"],
      "#types": ["./src/types.ts"],
      "#utils/*": ["./src/utils/*"]
    }
  },
  "extends": "@yapyak/typescript-config/react",
  "include": ["src/**/*"]
}
