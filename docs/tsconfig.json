{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#components/*": ["./src/components/*"],
      "#docs/*": ["./src/docs/*"],
      "#hooks/*": ["./src/hooks/*"],
      "#lib/*": ["./src/lib/*"],
      "#types": ["./src/types.ts"],
      "#utils/*": ["./src/utils/*"]
    },
    "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "extends": "@yapyak/typescript-config/react",
  "include": ["src/**/*", "manifest.json"]
}
