{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#components/*": [
        "./src/components/*"
      ],
      "#docs/*": [
        "./src/docs/*"
      ],
      "#hooks/*": [
        "./src/hooks/*"
      ],
      "#styles/*": [
        "./src/styles/*"
      ],
      "#types": [
        "./src/types.ts"
      ],
      "#utils/*": [
        "./src/utils/*"
      ]
    },
    "types": [
      "node",
      "vite/client",
      "@yapyak/doc-compiler/ambient"
    ]
  },
  "extends": "@yapyak/typescript-config/react",
  "include": [
    "src"
  ]
}
