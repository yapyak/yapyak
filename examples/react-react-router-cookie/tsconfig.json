{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "node",
      "vite/client"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    ".react-router/types",
    ".yapyak/types.d.ts",
    "app",
    "vite.config.ts"
  ]
}
